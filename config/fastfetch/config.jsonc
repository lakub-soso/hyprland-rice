// fastfetch — Catppuccin Macchiato, grouped with Nerd Font icons.
// Runs when a kitty window opens (config/zsh/.zshrc). Needs a Nerd Font.
// Docs: https://github.com/fastfetch-cli/fastfetch/wiki/Configuration
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "source": "arch",
        "color": {
            "1": "38;2;198;160;246",
            "2": "38;2;138;173;244"
        },
        "padding": {
            "top": 1,
            "left": 2,
            "right": 4
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "38;2;198;160;246",
            "output": "38;2;202;211;245",
            "separator": "38;2;110;115;141"
        },
        "key": {
            "width": 18
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "{#1;38;2;198;160;246}{user-name}{#0;38;2;110;115;141}@{#1;38;2;138;173;244}{host-name}"
        },
        "break",
        {
            "type": "custom",
            "format": "{#38;2;198;160;246}╭─ 󰒋  System"
        },
        {
            "type": "os",
            "key": "├─   OS",
            "keyColor": "38;2;198;160;246"
        },
        {
            "type": "kernel",
            "key": "├─   Kernel",
            "keyColor": "38;2;198;160;246"
        },
        {
            "type": "uptime",
            "key": "├─ 󰥔  Uptime",
            "keyColor": "38;2;198;160;246"
        },
        {
            "type": "packages",
            "key": "├─ 󰏖  Packages",
            "keyColor": "38;2;198;160;246"
        },
        {
            "type": "shell",
            "key": "├─   Shell",
            "keyColor": "38;2;198;160;246"
        },
        {
            "type": "wm",
            "key": "├─ 󰖶  WM",
            "keyColor": "38;2;198;160;246"
        },
        {
            "type": "terminal",
            "key": "╰─   Terminal",
            "keyColor": "38;2;198;160;246"
        },
        "break",
        {
            "type": "custom",
            "format": "{#38;2;138;173;244}╭─ 󰻴  Hardware"
        },
        {
            "type": "cpu",
            "key": "├─ 󰻠  CPU",
            "keyColor": "38;2;138;173;244"
        },
        {
            "type": "gpu",
            "key": "├─ 󰢮  GPU",
            "keyColor": "38;2;138;173;244"
        },
        {
            "type": "memory",
            "key": "├─ 󰍛  Memory",
            "keyColor": "38;2;138;173;244"
        },
        {
            "type": "display",
            "key": "├─ 󰍹  Display",
            "keyColor": "38;2;138;173;244"
        },
        {
            "type": "disk",
            "key": "╰─ 󰋊  Disk",
            "keyColor": "38;2;138;173;244"
        },
        "break",
        {
            "type": "custom",
            "format": "{#38;2;139;213;202}╭─ 󰸌  Look"
        },
        {
            "type": "theme",
            "key": "├─ 󰏘  Theme",
            "keyColor": "38;2;139;213;202",
            "format": "{theme2}"
        },
        {
            "type": "icons",
            "key": "├─ 󰵮  Icons",
            "keyColor": "38;2;139;213;202",
            "format": "{icons2}"
        },
        {
            "type": "cursor",
            "key": "├─ 󰆿  Cursor",
            "keyColor": "38;2;139;213;202"
        },
        {
            "type": "terminalfont",
            "key": "├─ 󰲏  Term font",
            "keyColor": "38;2;139;213;202"
        },
        {
            "type": "font",
            "key": "╰─   Font",
            "keyColor": "38;2;139;213;202",
            "format": "{font1}"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle",
            "paddingLeft": 3
        }
    ]
}
