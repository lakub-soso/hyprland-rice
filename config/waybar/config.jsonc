// -*- mode: jsonc -*-
{
    // Only show the bar on the main (Philips) monitor, by port name.
    // Waybar can't match a partial description (it needs make+model+serial,
    // which we keep out of the repo), so if you move the Philips to another
    // port, update this — check with `hyprctl monitors`.
    "output": "HDMI-A-2",

    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 4,

    "modules-left": ["hyprland/workspaces", "hyprland/submap", "hyprland/window"],
    "modules-center": ["clock#date", "clock#time", "mpris"],
    "modules-right": ["hyprland/language", "custom/mic", "pulseaudio", "power-profiles-daemon", "custom/sysmon", "tray"],

    "hyprland/workspaces": {
        // Show workspaces from every monitor, since this is the only bar
        "all-outputs": true
    },
    // Focused window: app icon + "App · current tab/file". The format joins
    // class and title; "rewrite" shortens per app (rules starting "(?:" run
    // before the "^" fallback — Waybar applies all matching rules in
    // alphabetical order). Hover shows the full title.
    "hyprland/window": {
        "format": "{class} · {title}",
        "rewrite": {
            "(?:com\\.microsoft\\.vscode|code|code-oss) · (.+?)(?: \\([^)]*\\))*(?: - .+?)? - Visual Studio Code": "VS Code · $1",
            "(?:com\\.microsoft\\.vscode|code|code-oss) · Visual Studio Code": "VS Code",
            "(?:firefox) · (.*) — Mozilla Firefox": "Firefox · $1",
            "(?:firefox) · Mozilla Firefox": "Firefox",
            "(?:librewolf) · (.*) — LibreWolf": "LibreWolf · $1",
            "(?:org\\.kde\\.dolphin) · (.*) — Dolphin": "Dolphin · $1",
            "(?:kitty) · (.*)": "Kitty · $1",
            "(?:org\\.telegram\\.desktop) · .*": "Telegram",
            "(?:spotify) · .*": "Spotify",
            "(?:com\\.obsproject\\.studio) · OBS .*": "OBS",
            "(?:com\\.obsproject\\.studio) · (?!OBS )(.*)": "OBS · $1",
            "^(?:[a-z0-9_-]+\\.)+([a-z0-9_-]+) · (.*)$": "$1 · $2",
            "^([^·]+) · (.*\\1.*)$": "$2"
        },
        "max-length": 50,
        "icon": true,
        "icon-size": 18,
        "tooltip-format": "{title}",
        "separate-outputs": false
    },
    "tray": { "spacing": 10 },
    // Date and time are separate modules so each can open its own app.
    // First day of week / date names follow LC_TIME (en_GB → Monday first).
    "clock#date": {
        "format": "{:%a %d %b}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "on-scroll": 1,
            "format": {
                "months":   "<span color='#c6a0f6'><b>{}</b></span>",
                "weekdays": "<span color='#8aadf4'><b>{}</b></span>",
                "today":    "<span color='#ed8796'><b><u>{}</u></b></span>"
            }
        },
        // scroll over the date to page through months in the tooltip
        "actions": { "on-scroll-up": "shift_up", "on-scroll-down": "shift_down" },
        "on-click": "gnome-calendar"
    },
    "clock#time": {
        "format": "{:%H:%M}",
        "tooltip-format": "Clocks, alarms &amp; timers",
        "on-click": "gnome-clocks"
    },
    "hyprland/language": {
        // format-<language code> supplies the "{}" in "format"
        "format": "{}",
        "format-en": "EN",
        "format-uk": "UA",
        "format-ru": "RU",
        "on-click": "hyprctl switchxkblayout all next"
    },
    // Hidden when nothing plays.
    "mpris": {
        "format": "{player_icon}  {dynamic}",
        "format-paused": "{status_icon}  {dynamic}",
        "dynamic-order": [
            "title",
            "artist"
        ],
        "dynamic-separator": " – ",
        "dynamic-len": 45,
        "player-icons": {
            "default": "",
            "spotify": "",
            "firefox": "",
            "chromium": "",
            "brave": "",
            "mpv": "",
            "vlc": "󰕼"
        },
        "status-icons": {
            "paused": ""
        },
        "tooltip-format": "{player}: {artist} – {title}\n{album}",
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-click-middle": "playerctl previous",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous"
    },
    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power profile: {profile}\nDriver: {driver}\nclick: next · right-click: previous",
        "format-icons": {
            "power-saver": "󰾆",
            "balanced": "󰾅",
            "performance": "󰓅",
            "default": "󰾅"
        }
    },
    "custom/sysmon": {
        "exec": "~/.config/hypr/scripts/sysmon.py",
        "return-type": "json",
        "on-click": "missioncenter",
        "on-click-right": "coolercontrol",   // fan curves
        "escape": false
    },
    // Appears only while an app records from a real mic.
    // Event-driven (pactl subscribe) — hypr/scripts/mic.sh
    "custom/mic": {
        "exec": "~/.config/hypr/scripts/mic.sh",
        "return-type": "json",
        "on-click": "~/.config/hypr/scripts/mic.sh toggle",
        "escape": false
    },
    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "󰝟  muted",
        // level icon (low/medium/high); on headphones/headsets the headphones
        // icon sits next to it
        "format-icons": {
            "headphone": ["󰋋 󰕿", "󰋋 󰖀", "󰋋 󰕾"],
            "headset": ["󰋋 󰕿", "󰋋 󰖀", "󰋋 󰕾"],
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "scroll-step": 5,
        "max-volume": 100,
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "tooltip-format": "{desc}: {volume}%"
    }
}
