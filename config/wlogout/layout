{
    "label" : "lock",
    "action" : "pidof hyprlock || hyprlock",
    "text" : "Lock",
    "keybind" : "l"
}
{
    "label" : "suspend",
    "action" : "(pidof hyprlock || hyprlock &) ; sleep 1 ; systemctl suspend",
    "text" : "Suspend",
    "keybind" : "s"
}
{
    "label" : "logout",
    "action" : "command -v hyprshutdown >/dev/null 2>&1 && hyprshutdown || hyprctl dispatch 'hl.dsp.exit()'",
    "text" : "Log out",
    "keybind" : "e"
}
{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "text" : "Restart",
    "keybind" : "r"
}
{
    "label" : "shutdown",
    "action" : "systemctl poweroff",
    "text" : "Shut down",
    "keybind" : "p"
}
