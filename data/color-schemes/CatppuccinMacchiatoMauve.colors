# Deep mauve (mauve blended 40% over base) with light text, not pastel mauve
# with dark text: Breeze draws selected sidebar items with the *normal* (light)
# text colour, which is unreadable on pastel mauve.
[Colors:Selection]
BackgroundNormal=101,87,133
BackgroundAlternate=95,99,134
ForegroundNormal=202,211,245
ForegroundInactive=165,173,203
ForegroundActive=183,189,248
ForegroundLink=138,173,244
ForegroundVisited=198,160,246
ForegroundNegative=237,135,150
ForegroundNeutral=245,169,127
ForegroundPositive=166,218,149
DecorationFocus=198,160,246
DecorationHover=198,160,246

