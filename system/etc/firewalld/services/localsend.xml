<?xml version="1.0" encoding="utf-8"?>
<!-- LocalSend (AirDrop-like file transfer on the LAN). Installed by
     ./install.sh system, which also enables it in firewalld's default zone.
     Port 53317: HTTP transfers (TCP) + discovery via UDP multicast
     224.0.0.167. https://github.com/localsend/protocol -->
<service>
  <short>LocalSend</short>
  <description>LocalSend file sharing: transfers (TCP) and device discovery (UDP multicast) on port 53317.</description>
  <port protocol="tcp" port="53317"/>
  <port protocol="udp" port="53317"/>
</service>
